{
  "name": "content-generator",
  "version": "0.1.0",
  "description": "AI-assisted episodic content generation agent for kids YouTube, built on freetier-deepagent-framework.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "db:setup": "tsx src/state/migrate.ts",
    "db:cleanup:turso": "tsx scripts/cleanupTursoTables.ts",
    "db:cleanup:neon": "tsx scripts/cleanupNeonTables.ts",
    "db:cleanup:turso:selective": "tsx scripts/selectiveCleanupTurso.ts",
    "db:cleanup:neon:selective": "tsx scripts/selectiveCleanupNeon.ts",
    "db:migrate-signatures": "tsx scripts/migrateCharacterSignaturePrompts.ts",
    "episode:scheduler-skip": "tsx scripts/setEpisodeSchedulerSkip.ts",
    "smoke:one-minute": "tsx scripts/smokeOneMinuteEpisode.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@freetier/orchestrator": "github:RY0502/freetier-orchestrator",
    "@langchain/core": "^1.0.0",
    "@libsql/client": "^0.17.4",
    "deepagents": "^1.12.3",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "freetier-deepagent-framework": "github:RY0502/freetier-deepagent-framework",
    "google-auth-library": "^11.0.0",
    "googleapis": "^173.0.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
