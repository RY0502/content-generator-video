# --- freetier-deepagent-framework (main deep-agent provider rotation) ---
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_DEEP_AGENT_MODEL=
HUGGINGFACE_DEEP_AGENT_MODEL=
OPENROUTER_DEEP_AGENT_MODEL=
TAVILY_API_KEY=
NEON_DATABASE_URL=

# --- Agent lifecycle ---
# Every canonical agent invocation first clears Neon framework/checkpoint state.
# After success, an early return, or an error, it sends exactly one GET to:
#   ${PAUSE_BASE_URL}/pause/vm?machine=${MACHINE_NO}
PAUSE_BASE_URL=
# MACHINE_NO is accepted as an uppercase compatibility alias.
MACHINE_NO=

# Domain state, media receipts, and assembled-output records (Turso/libSQL).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Framework/orchestrator media tools ---
# Narration uses the framework audio tool with Groq Orpheus. Numbered keys can
# rotate on provider quota errors.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
# --- OpenRouter vision/reasoning for character-sheet analysis ---
# Reuses OPENROUTER_API_KEY above and falls back to framework rotation.
OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# --- Groq text reasoning ---
# GROQ_API_KEY is retained as a backward-compatible fallback for voice-selection reasoning.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- AnyAPI: character portraits and post-download video QA ---
ANYAPI_KEY=
ANYAPI_KEY_2=
ANYAPI_KEY_3=
# ANYAPI_KEY_4=
# ANYAPI_KEY_5=
# ANYAPI_KEY_6=
# ANYAPI_KEY_7=
# ANYAPI_KEY_8=
ANYAPI_BASE_URL=https://api.anyapi.ai
# Image-generation model used only for main-character portraits.
ANYAPI_IMAGE_MODEL=google/gemini-3.1-flash-image
# AnyAPI vision-chat model used only to judge high-resolution Agnes contact sheets.
# This remains independent from the portrait-generation model above.
ANYAPI_VIDEO_QA_MODEL=google/gemini-3.1-pro-preview
# Three target clips per sheet normally produces about 18 calls for 50 scenes
# plus both title clips. The tool automatically increases the batch size to
# remain at or below the configured maximum for 60-scene episodes.
VIDEO_QA_SCENES_PER_SHEET=3
VIDEO_QA_MAX_VISION_CALLS=20
VIDEO_QA_REQUEST_TIMEOUT_MS=120000
VIDEO_QA_ANYAPI_RPM_PER_KEY=9
VIDEO_QA_MIN_CONFIDENCE=0.8
# Production accepts only 0 or 1; values above 1 are clamped to 1.
VIDEO_QA_MAX_REGENERATIONS=1

# --- Agnes Video 2.5 Flash direct key-art and scene videos ---
# Each key is a separately approved Agnes account lane. The unsuffixed key is
# lane 1 (AGNES_API_KEY_1 is also accepted); add _2, _3, ... only for separate
# accounts. Do not use several keys from one account as independent lanes.
# Optional non-secret stable IDs default to account-1, account-2, ... and should
# stay unchanged when a credential is replaced. Do not set an unsuffixed value
# and its _1 alias to different values. Cross-account failover is only for a
# definite key-scoped rate/daily/quota/credit rejection. Queue capacity, auth or
# configuration errors, network/timeout/5xx errors, and ambiguous responses do
# not fail over. Accepted jobs are always retrieved with the exact submitting
# account/key. New requests automatically use approved character portraits as
# Agnes image references when every visible portrait already has an HTTPS URL,
# or when both optional publisher base URLs below are configured. With neither,
# the exact same resumable workflow cleanly remains text-to-video.
AGNES_API_KEY=
# AGNES_API_KEY_2=
# AGNES_API_KEY_3=
# AGNES_API_KEY_4=
# AGNES_API_KEY_5=
# AGNES_ACCOUNT_ID=account-1
# AGNES_ACCOUNT_ID_2=account-2
# AGNES_ACCOUNT_ID_3=account-3
# AGNES_ACCOUNT_ID_4=account-4
# AGNES_ACCOUNT_ID_5=account-5
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_REQUEST_TIMEOUT_MS=60000
# This legacy status interval is an additional minimum. Production status starts
# also obey the per-account RPM interval and a 30-second floor.
AGNES_POLL_INTERVAL_MS=30000
AGNES_POLL_WINDOW_MS=480000
# Queue acknowledgement checks an intermediate state every 30 seconds for at
# most five minutes. Accepted queued/in-progress jobs are verified on later runs.
AGNES_QUEUE_POLL_INTERVAL_MS=30000
AGNES_QUEUE_POLL_WINDOW_MS=300000
# Two is the production submission-worker ceiling per configured account lane.
AGNES_SUBMISSION_BATCH_SIZE=2
# Independent per-account request-start budgets. Both default to two per minute;
# slots and provider cooldowns persist in Turso across process restarts.
AGNES_SUBMISSION_RPM_PER_ACCOUNT=2
AGNES_STATUS_RPM_PER_ACCOUNT=2
AGNES_MAX_DOWNLOAD_BYTES=500000000
# This legacy interval can only add spacing beyond the submission RPM floor.
# 0 means no additional delay; it never disables the per-account RPM gate.
AGNES_SUBMISSION_INTERVAL_MS=0
# Optional preferred initial series seed (0..2147483647). It is persisted only
# if the series has no seed; later runs reuse the stored value even if this
# changes. Blank creates and persists a random initial series seed.
AGNES_SEED=
# Optional PUT-compatible object gateway for publishing local approved portraits.
# The public base must be anonymously readable over HTTPS for the lifetime of
# every Agnes task. The bearer token is sent only to the PUT endpoint.
# AGNES_REFERENCE_UPLOAD_BASE_URL=https://uploads.example.com/agnes-references
# AGNES_REFERENCE_PUBLIC_BASE_URL=https://cdn.example.com/agnes-references
# AGNES_REFERENCE_UPLOAD_BEARER_TOKEN=
# ffmpeg and ffprobe are bundled via @ffmpeg-installer/ffmpeg and @ffprobe-installer/ffprobe.
# No global install needed. Override only if you want a specific custom binary:
# FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe
# FFPROBE_PATH=C:\\ffmpeg\\bin\\ffprobe.exe

# --- Series / episode configuration ---
# OUTPUT_DIR stores narration metadata/WAVs, Agnes receipts/MP4s, captions,
# optional sounds, and the assembled episode. ASSETS_DIR stores character sheets;
# no key art or scene images are generated by the production flow.
EPISODE_DAILY_TIMEZONE=Asia/Kolkata
OUTPUT_DIR=./output
ASSETS_DIR=./assets
BURN_SUBTITLES=false

# --- YouTube Data API v3 (for video upload) ---
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable YouTube Data API v3
# 3. Create OAuth 2.0 credentials (Desktop app type)
# 4. Use the OAuth playground or a script to exchange authorization code for refresh token
# 5. Set the refresh token here (it never expires unless revoked)
# Keep false to omit upload_to_youtube from the agent entirely. Set true only
# when automatic uploads should be enabled again.
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REFRESH_TOKEN=your-refresh-token
